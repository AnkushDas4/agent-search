# Optional Bearer token to protect /v1/* and /mcp endpoints.
# Leave unset for open local / Android Termux usage.
SEARCH_API_KEY=

# HTTP server port (standalone Node / Docker / Termux)
PORT=8787
HOST=0.0.0.0

# Cache settings
CACHE_TTL_MS=900000
CACHE_MAX_ENTRIES=256
# Optional custom directory for persistent JSON cache (defaults to ./data/cache when writable)
# CACHE_DIR=./data/cache

# Optional custom directory for api-anything state & synced site specs
# API_ANYTHING_HOME=./data/api-anything
API_ANYTHING_LOCAL_ONLY=1
