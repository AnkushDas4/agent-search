{
  "name": "qwant",
  "displayName": "Qwant",
  "baseUrl": "https://api.qwant.com",
  "description": "Public organic web search JSON API from Qwant (api.qwant.com/v3/search/web).",
  "operations": [
    {
      "name": "search",
      "description": "Search public web results via Qwant v3 JSON API.",
      "request": {
        "method": "GET",
        "url": "https://api.qwant.com/v3/search/web?q=%7Bquery%7D&count=10&locale=en_US&t=web&uiv=4",
        "headers": {
          "accept": "application/json, text/plain, */*",
          "accept-language": "en-US,en;q=0.9",
          "origin": "https://www.qwant.com",
          "referer": "https://www.qwant.com/",
          "sec-ch-ua": "\"Chromium\";v=\"136\", \"Google Chrome\";v=\"136\", \"Not.A/Brand\";v=\"99\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "empty",
          "sec-fetch-mode": "cors",
          "sec-fetch-site": "same-site",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:q"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://api.qwant.com/v3/search/web?q={query}&count=10&locale=en_US&t=web&uiv=4"
      },
      "match": {
        "method": "GET",
        "host": "api.qwant.com",
        "path": "/v3/search/web"
      },
      "response": {
        "format": "json",
        "contentType": "application/json",
        "extract": "data.result.items.mainline",
        "pick": [
          "type",
          "items"
        ]
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Public web search query.",
          "example": "hono framework"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "query": "model context protocol"
          },
          "expect": "result",
          "purpose": "A different public search query returns results."
        }
      ]
    }
  ]
}
