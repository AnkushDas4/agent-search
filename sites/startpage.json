{
  "name": "startpage",
  "displayName": "Startpage",
  "baseUrl": "https://www.startpage.com",
  "description": "Public organic web search results from Startpage (www.startpage.com/sp/search).",
  "operations": [
    {
      "name": "search",
      "description": "Search public web results via Startpage server-rendered HTML.",
      "request": {
        "method": "GET",
        "url": "https://www.startpage.com/sp/search?query=%7Bquery%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "referer": "https://www.startpage.com/",
          "sec-ch-ua": "\"Chromium\";v=\"136\", \"Google Chrome\";v=\"136\", \"Not.A/Brand\";v=\"99\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "same-origin",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:query"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.startpage.com/sp/search?query={query}"
      },
      "match": {
        "method": "GET",
        "host": "www.startpage.com",
        "path": "/sp/search"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=utf-8",
        "html": {
          "items": ".w-gl__result",
          "fields": {
            "title": "a.w-gl__result-title, a.result-link, h3",
            "url": "a.w-gl__result-title@href, a.result-link@href",
            "snippet": "p.w-gl__description, .w-gl__description, p.description"
          }
        }
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Public web search query.",
          "example": "typescript web framework"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "query": "rust async runtime"
          },
          "expect": "result",
          "purpose": "A different public search query returns results."
        }
      ]
    }
  ]
}
