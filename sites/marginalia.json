{
  "name": "marginalia",
  "displayName": "Marginalia Search",
  "baseUrl": "https://api2.marginalia-search.com",
  "description": "Independent non-commercial web search JSON API from Marginalia Search (api2.marginalia-search.com).",
  "operations": [
    {
      "name": "search",
      "description": "Search Marginalia's independent index via the api2.marginalia-search.com JSON endpoint.",
      "request": {
        "method": "GET",
        "url": "https://api2.marginalia-search.com/search?query=%7Bquery%7D&count=10",
        "headers": {
          "accept": "application/json",
          "accept-language": "en-US,en;q=0.9",
          "api-key": "public",
          "user-agent": "agent-search/1.0 (+https://github.com/AnkushDas4/agent-search)"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:query"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://api2.marginalia-search.com/search?query={query}&count=10"
      },
      "match": {
        "method": "GET",
        "host": "api2.marginalia-search.com",
        "path": "/search"
      },
      "response": {
        "format": "json",
        "contentType": "application/json",
        "extract": "results",
        "pick": [
          "url",
          "title",
          "description"
        ]
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Public web search query.",
          "example": "sqlite documentation"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "query": "linux kernel"
          },
          "expect": "result",
          "purpose": "A different public search query returns results."
        }
      ]
    }
  ]
}
