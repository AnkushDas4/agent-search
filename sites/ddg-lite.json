{
  "name": "ddg-lite",
  "displayName": "DuckDuckGo Lite",
  "baseUrl": "https://lite.duckduckgo.com",
  "description": "Public organic web search results from DuckDuckGo Lite (lite.duckduckgo.com/lite/).",
  "operations": [
    {
      "name": "search",
      "description": "Search public web results via DuckDuckGo Lite.",
      "request": {
        "method": "GET",
        "url": "https://lite.duckduckgo.com/lite/?q=%7Bquery%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "referer": "https://lite.duckduckgo.com/",
          "sec-ch-ua": "\"Chromium\";v=\"136\", \"Google Chrome\";v=\"136\", \"Not.A/Brand\";v=\"99\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "same-origin",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:q"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://lite.duckduckgo.com/lite/?q={query}"
      },
      "match": {
        "method": "GET",
        "host": "lite.duckduckgo.com",
        "path": "/lite/"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=UTF-8",
        "html": {
          "items": "tr:not(.result-sponsored) a.result-link",
          "fields": {
            "title": "",
            "url": "@href"
          }
        }
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Public web search query.",
          "example": "typescript runtime"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "query": "rust programming"
          },
          "expect": "result",
          "purpose": "A different public search query returns results."
        }
      ]
    }
  ]
}
