{
  "name": "mojeek",
  "displayName": "Mojeek",
  "baseUrl": "https://www.mojeek.com",
  "description": "Public organic web search results from Mojeek's independent search index (www.mojeek.com).",
  "operations": [
    {
      "name": "search",
      "description": "Search public web results via Mojeek (up to 20 results).",
      "request": {
        "method": "GET",
        "url": "https://www.mojeek.com/search?q=%7Bquery%7D&t=20",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Chromium\";v=\"136\", \"Google Chrome\";v=\"136\", \"Not.A/Brand\";v=\"99\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "query",
          "at": [
            "query:q"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.mojeek.com/search?q={query}&t=20"
      },
      "match": {
        "method": "GET",
        "host": "www.mojeek.com",
        "path": "/search"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=utf-8",
        "html": {
          "items": "ul.results-standard li",
          "fields": {
            "title": "h2 a, a.title",
            "url": "a.ob@href, h2 a@href",
            "snippet": "p.s"
          }
        }
      },
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Public web search query.",
          "example": "typescript runtime"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "checks": [
        {
          "args": {
            "query": "rust programming"
          },
          "expect": "result",
          "purpose": "A different public search query returns organic web results."
        }
      ]
    }
  ]
}
